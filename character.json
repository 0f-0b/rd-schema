{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://0f-0b.github.io/rd-schema/character.json",
  "$ref": "#/definitions/Character",
  "definitions": {
    "Character": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "size": {
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Clip"
          }
        },
        "rowPreviewOffset": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "rowPreviewFrame": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "rowPreviewScale": {
          "type": "number"
        },
        "pivotOffset": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "reflectionOffset": {
          "type": "number"
        },
        "portraitOffset": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "portraitSize": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "portraitScale": {
          "type": "number"
        }
      },
      "required": [
        "size",
        "clips"
      ],
      "additionalProperties": false
    },
    "Clip": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^-?\\d+$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": ":"
              },
              {
                "type": "object",
                "properties": {
                  "changeExpressionPrefix": {
                    "type": "string"
                  },
                  "changeCharacter": {
                    "type": "string"
                  },
                  "playClip": {
                    "type": "string"
                  },
                  "playExpression": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "endEvent": {
          "type": "string",
          "pattern": ":"
        },
        "loopStart": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "loop": {
          "type": "string",
          "enum": [
            "yes",
            "freeze",
            "onBeat",
            "no"
          ]
        },
        "fps": {
          "type": "number"
        },
        "pivotOffset": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "reflectionOffset": {
          "type": "number"
        },
        "portraitOffset": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "portraitSize": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "portraitName": {
          "type": "string"
        },
        "portraitScale": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "frames",
        "loop"
      ],
      "additionalProperties": false
    }
  }
}
