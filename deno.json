{
  "unstable": ["raw-imports"],
  "imports": {
    "@dprint/formatter": "jsr:@dprint/formatter@^0.5.0",
    "@dprint/typescript": "npm:@dprint/typescript@^0.96.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "pe-struct": "npm:pe-struct@0.9.4",
    "type-fest": "npm:type-fest@^5.0.0",
    "zod": "jsr:@zod/zod@4.4.3"
  },
  "compilerOptions": {
    "exactOptionalPropertyTypes": true
  },
  "lint": {
    "exclude": ["character.d.ts", "level.d.ts"],
    "rules": {
      "include": ["verbatim-module-syntax"]
    }
  },
  "tasks": {
    "cache": "deno cache --allow-import=jsr.io:443 generate.ts",
    "lint": "deno fmt --check && deno lint && deno check --allow-import=jsr.io:443 generate.ts"
  }
}
